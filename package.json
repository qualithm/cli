{
  "name": "@qualithm/cli",
  "version": "0.0.0",
  "description": "CLI and MCP server for managing devices and teams on Qualithm.",
  "private": false,
  "type": "module",
  "keywords": [
    "qualithm",
    "cli",
    "mcp",
    "iot"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Qualithm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualithm/cli.git"
  },
  "homepage": "https://github.com/qualithm/cli#readme",
  "bugs": {
    "url": "https://github.com/qualithm/cli/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "deno": "./dist/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "dev": "bun --watch run src/bin/qualithm.ts",
    "docs": "typedoc",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "bun run clean && bun run build",
    "start": "bun run src/bin/qualithm.ts",
    "test": "vitest run src/__tests__/unit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage src/__tests__/unit",
    "test:unit": "vitest run src/__tests__/unit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "validate:runtime": "bun run scripts/validate-runtime.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@qualithm/platform": "0.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.5.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.12"
  },
  "bin": {
    "qualithm": "./dist/bin/qualithm.js"
  }
}
